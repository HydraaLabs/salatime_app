<?xml version="1.0" encoding="utf-8"?>
<!-- Debug only: allow interception with tools like HTTP Toolkit by trusting
     user-installed CA certificates in addition to system CAs. -->
<network-security-config>
    <base-config>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
