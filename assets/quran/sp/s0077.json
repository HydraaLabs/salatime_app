                    {
                        "id": 5636,
                        "chapter_id": 77,
                        "verses_translate_name": "versos",
                        "verses_number": "14",
                        "arabic_name": "وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلْفَصْلِ",
                        "translated_name": "Y ¿Qué te hará entender lo que es el Día de la Diferencia?"
                    },
                    {
                        "id": 5637,
                        "chapter_id": 77,
                        "verses_translate_name": "versos",
                        "verses_number": "15",
                        "arabic_name": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
