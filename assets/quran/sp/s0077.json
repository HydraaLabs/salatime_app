                    },
                    {
                        "id": 5635,
                        "chapter_id": 77,
                        "verses_translate_name": "versos",
                        "verses_number": "13",
                        "arabic_name": "لِيَوْمِ ٱلْفَصْلِ",
                        "translated_name": "Al Día de la Diferencia."
