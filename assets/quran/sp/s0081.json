                        "verses_translate_name": "versos",
                        "verses_number": "12",
                        "arabic_name": "وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ",
                        "translated_name": "y cuando el Infierno sea avivado"
                    },
                    {
                        "id": 5813,
                        "chapter_id": 81,
                        "verses_translate_name": "versos",
                        "verses_number": "13",
                        "arabic_name": "وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ",
                        "translated_name": "y cuando el Jardín sea aproximado,"
                    },
                    {
                        "id": 5814,
                        "chapter_id": 81,
                        "verses_translate_name": "versos",
                        "verses_number": "14",
                        "arabic_name": "عَلِمَتْ نَفْسٌ مَّآ أَحْضَرَتْ",
                        "translated_name": "entonces, cada alma conocerá lo que presenta."
                    },
                    {
