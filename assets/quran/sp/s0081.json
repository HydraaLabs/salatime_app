                        "chapter_id": 81,
                        "verses_translate_name": "versos",
                        "verses_number": "7",
                        "arabic_name": "وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ",
                        "translated_name": "y cuando las almas sean emparejadas"
                    },
                    {
                        "id": 5808,
                        "chapter_id": 81,
                        "verses_translate_name": "versos",
                        "verses_number": "8",
                        "arabic_name": "وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ",
                        "translated_name": "y cuando a la niña enterrada viva se le pregunte"
