                        "verses_translate_name": "versos",
                        "verses_number": "9",
                        "arabic_name": "بِأَىِّ ذَنۢبٍ قُتِلَتْ",
                        "translated_name": "por qué delito fue matada"
                    },
                    {
                        "id": 5810,
                        "chapter_id": 81,
                        "verses_translate_name": "versos",
                        "verses_number": "10",
                        "arabic_name": "وَإِذَا ٱلصُّحُفُ نُشِرَتْ",
                        "translated_name": "y cuando las páginas escritas sean desenrolladas"
                    },
                    {
