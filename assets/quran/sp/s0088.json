                        "chapter_id": 88,
                        "verses_translate_name": "versos",
                        "verses_number": "2",
                        "arabic_name": "وُجُوهٌ يَوْمَئِذٍ خَـٰشِعَةٌ",
                        "translated_name": "Algunos rostros, ese día, estarán sombríos,"
                    },
                    {
                        "id": 5970,
