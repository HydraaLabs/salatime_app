{"schemaVersion":1,"languageCode":"tr","editionKey":"turkish_rwwad","version":"1.0.4","surah":102,"verses":{"1":{"translation":"Çoklukla övünmek sizi oyaladı.","footnotes":""},"2":{"translation":"Ta ki, kabirleri ziyaret edinceye/ölünceye dek devam ettiniz.","footnotes":""},"3":{"translation":"Hayır! İlerde bileceksiniz.","footnotes":""},"4":{"translation":"Yine hayır! İleride bileceksiniz.","footnotes":""},"5":{"translation":"Hayır! Kesin bir bilgiyle bilseydiniz (kaçınırdınız).","footnotes":""},"6":{"translation":"Elbette Cehennem'i göreceksiniz.","footnotes":""},"7":{"translation":"Yine andolsun, onu gözünüzle kesin olarak göreceksiniz.","footnotes":""},"8":{"translation":"Sonra o gün, nimetlerden hesaba çekileceksiniz.","footnotes":""}}}
