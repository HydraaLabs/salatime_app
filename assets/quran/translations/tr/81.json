{"schemaVersion":1,"languageCode":"tr","editionKey":"turkish_rwwad","version":"1.0.4","surah":81,"verses":{"1":{"translation":"Güneş dürüldüğü zaman.","footnotes":""},"2":{"translation":"Yıldızlar, saçılıp dağıldığı zaman.","footnotes":""},"3":{"translation":"Dağlar yürütüldüğü zaman.","footnotes":""},"4":{"translation":"Gebe develer başıboş bırakıldığı zaman.","footnotes":""},"5":{"translation":"Vahşi hayvanlar bir araya toplandığı zaman.","footnotes":""},"6":{"translation":"Denizler tutuşturulduğu zaman.","footnotes":""},"7":{"translation":"Nefisler/kişiler (benzerleriyle) birleştirildiği zaman.","footnotes":""},"8":{"translation":"Diri diri (toprağa) gömülen kız çocuğuna sorulduğu zaman.","footnotes":""},"9":{"translation":"\"Hangi günâhtan dolayı öldürüldü?\" (diye).","footnotes":""},"10":{"translation":"Sahifeler (amel defterleri) açıldığı zaman.","footnotes":""},"11":{"translation":"Gök, sıyrılıp ayrıldığı zaman.","footnotes":""},"12":{"translation":"Cehennem alevlendirildiği zaman.","footnotes":""},"13":{"translation":"Ve Cennet yaklaştırıldığı zaman.","footnotes":""},"14":{"translation":"Her nefis önceden ne hazırladığını bilecektir.","footnotes":""},"15":{"translation":"Hayır! Yemin ederim gizlenen (yıldızlara).","footnotes":""},"16":{"translation":"O akıp akıp yörüngesinde giden ve gizlenenlere.","footnotes":""},"17":{"translation":"Karardığında geceye.","footnotes":""},"18":{"translation":"Aydınlanmaya başladığında sabaha.","footnotes":""},"19":{"translation":"Şüphesiz o, çok değerli bir elçinin sözüdür.","footnotes":""},"20":{"translation":"Kuvvet sahibi; Arşın sahibinin katında itibarlı (bir elçinin).","footnotes":""},"21":{"translation":"Kendine itaat edilen, üstelik güvenilir.","footnotes":""},"22":{"translation":"Arkadaşınız bir mecnun değildir.","footnotes":""},"23":{"translation":"Onu (Cebrail'i) ufukta apaçık görmüştür.","footnotes":""},"24":{"translation":"O, gayp hakkında cimri değildir.","footnotes":""},"25":{"translation":"O, kovulmuş Şeytan'ın sözü de değildir.","footnotes":""},"26":{"translation":"Öyleyse nereye gidiyorsunuz?","footnotes":""},"27":{"translation":"O, yalnızca bütün âlemler için bir öğüttür.","footnotes":""},"28":{"translation":"Sizden dosdoğru olmak isteyenler için.","footnotes":""},"29":{"translation":"Âlemlerin Rabbi Allah dilemedikçe siz de dileyemezsiniz.","footnotes":""}}}
