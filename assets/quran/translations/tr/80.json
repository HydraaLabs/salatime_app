{"schemaVersion":1,"languageCode":"tr","editionKey":"turkish_rwwad","version":"1.0.4","surah":80,"verses":{"1":{"translation":"Yüzünü ekşitti ve arkasını döndü.","footnotes":""},"2":{"translation":"Kendisine o âmâ geldi diye.","footnotes":""},"3":{"translation":"Ne bilirsin belki o temizlenecekti.","footnotes":""},"4":{"translation":"Yahut öğüt alacaktı da bu öğüt ona fayda verecekti.","footnotes":""},"5":{"translation":"Kendini muhtaç hissetmeyene gelince;","footnotes":""},"6":{"translation":"Sen, ona yöneliyorsun.","footnotes":""},"7":{"translation":"(İstemiyorsa) arınmamasından sen sorumlu değilsin!","footnotes":""},"8":{"translation":"Fakat koşup sana gelen kimse;","footnotes":""},"9":{"translation":"(Allah'tan) korkuğu halde;","footnotes":""},"10":{"translation":"Sen onu bırakıp oyalanıyorsun.","footnotes":""},"11":{"translation":"Hayır. Bu ancak bir öğüttür.","footnotes":""},"12":{"translation":"Artık dileyen kimse ondan öğüt alır.","footnotes":""},"13":{"translation":"(O) şerefli sahifelerdedir.","footnotes":""},"14":{"translation":"Yüce ve tertemiz olan.","footnotes":""},"15":{"translation":"Kâtiplerin ellerinde.","footnotes":""},"16":{"translation":"Değerli ve itaatkâr olan (Meleklerin).","footnotes":""},"17":{"translation":"Kahrolası (inkârcı) insan! Ne nankördür o!","footnotes":""},"18":{"translation":"Allah, onu hangi şeyden yarattı?","footnotes":""},"19":{"translation":"Bir nutfeden yarattı ve belli bir şekle soktu.","footnotes":""},"20":{"translation":"Sonra da ona yolu kolaylaştırdı.","footnotes":""},"21":{"translation":"Sonra da onu öldürüp kabre koydu.","footnotes":""},"22":{"translation":"Sonra dilediği zaman onu yeniden diriltir.","footnotes":""},"23":{"translation":"Hayır. O (Rabbinin) kendisine emrettiğini yerine getirmedi.","footnotes":""},"24":{"translation":"İnsan yiyeceğine bir baksın.","footnotes":""},"25":{"translation":"Şüphesiz biz suyu/yağmuru döktükçe döktük.","footnotes":""},"26":{"translation":"Sonra toprağı iyiden iyiye yardık!","footnotes":""},"27":{"translation":"Ve orada taneler bitirdik.","footnotes":""},"28":{"translation":"Üzümler ve yoncalar,","footnotes":""},"29":{"translation":"Zeytinler ve hurmalar,","footnotes":""},"30":{"translation":"Sık ağaçlı bahçeler,","footnotes":""},"31":{"translation":"Meyveler ve otlaklar,","footnotes":""},"32":{"translation":"Sizin ve hayvanlarınızın yararlanması için,","footnotes":""},"33":{"translation":"Kulakları sağır eden o ses geldiğinde,","footnotes":""},"34":{"translation":"O gün kişi kardeşinden kaçar.","footnotes":""},"35":{"translation":"Anasından ve babasından,","footnotes":""},"36":{"translation":"Eşinden ve evladından,","footnotes":""},"37":{"translation":"O gün herkes için kendine yetecek bir işi vardır.","footnotes":""},"38":{"translation":"O gün birtakım yüzler vardır ki pırıl pırıl parlarlar.","footnotes":""},"39":{"translation":"Güleç ve neşelidir.","footnotes":""},"40":{"translation":"Öyle yüzler de var ki o gün üzerini toz kaplamıştır.","footnotes":""},"41":{"translation":"Onları bir siyahlık bürür.","footnotes":""},"42":{"translation":"İşte onlar kâfirler, facirlerdir.","footnotes":""}}}
