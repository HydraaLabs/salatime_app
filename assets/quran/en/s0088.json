                        "id": 5980,
                        "chapter_id": 88,
                        "verses_translate_name": "Verses",
                        "verses_number": "13",
                        "arabic_name": "فِيهَا سُرُرٌ مَّرْفُوعَةٌ",
                        "translated_name": "And within it are couches placed on high,"
                    },
                    {
                        "id": 5981,
