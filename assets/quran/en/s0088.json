                        "verses_translate_name": "Verses",
                        "verses_number": "15",
                        "arabic_name": "وَنَمَارِقُ مَصْفُوفَةٌ",
                        "translated_name": "Cushions arranged,"
                    },
                    {
                        "id": 5983,
                        "chapter_id": 88,
                        "verses_translate_name": "Verses",
                        "verses_number": "16",
                        "arabic_name": "وَزَرَابِىُّ مَبْثُوثَةٌ",
                        "translated_name": "And rich carpets spread."
                    },
                    {
                        "id": 5984,
                        "chapter_id": 88,
                        "verses_translate_name": "Verses",
                        "verses_number": "17",
                        "arabic_name": "أَفَلَا يَنظُرُونَ إِلَى ٱلْإِبِلِ كَيْفَ خُلِقَتْ",
                        "translated_name": "Do they not then ponder how the clouds were formed;"
