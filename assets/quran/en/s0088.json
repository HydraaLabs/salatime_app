                    {
                        "id": 5971,
                        "chapter_id": 88,
                        "verses_translate_name": "Verses",
                        "verses_number": "4",
                        "arabic_name": "تَصْلَىٰ نَارًا حَامِيَةً",
                        "translated_name": "Burning in the scorching fire,"
                    },
                    {
                        "id": 5972,
                        "chapter_id": 88,
                        "verses_translate_name": "Verses",
                        "verses_number": "5",
                        "arabic_name": "تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍ",
                        "translated_name": "Given water from the boiling spring to drink."
                    },
                    {
                        "id": 5973,
                        "chapter_id": 88,
                        "verses_translate_name": "Verses",
                        "verses_number": "6",
                        "arabic_name": "لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٍ",
                        "translated_name": "They will have no food except bitter thorn,"
                    },
                    {
                        "id": 5974,
                        "chapter_id": 88,
                        "verses_translate_name": "Verses",
                        "verses_number": "7",
                        "arabic_name": "لَّا يُسْمِنُ وَلَا يُغْنِى مِن جُوعٍ",
                        "translated_name": "Neither nourishing nor banishing hunger."
                    },
                    {
                        "id": 5975,
                        "chapter_id": 88,
                        "verses_translate_name": "Verses",
                        "verses_number": "8",
                        "arabic_name": "وُجُوهٌ يَوْمَئِذٍ نَّاعِمَةٌ",
                        "translated_name": "Many faces will be joyous on that day,"
                    },
                    {
                        "id": 5976,
                        "chapter_id": 88,
                        "verses_translate_name": "Verses",
                        "verses_number": "9",
                        "arabic_name": "لِّسَعْيِهَا رَاضِيَةٌ",
                        "translated_name": "Well-pleased with their endeavour,"
                    },
                    {
                        "id": 5977,
                        "chapter_id": 88,
                        "verses_translate_name": "Verses",
                        "verses_number": "10",
                        "arabic_name": "فِى جَنَّةٍ عَالِيَةٍ",
                        "translated_name": "In the high empyrean,"
                    },
                    {
                        "id": 5978,
                        "chapter_id": 88,
                        "verses_translate_name": "Verses",
                        "verses_number": "11",
                        "arabic_name": "لَّا تَسْمَعُ فِيهَا لَـٰغِيَةً",
                        "translated_name": "Never hearing idle talk."
                    },
                    {
                        "id": 5979,
                        "chapter_id": 88,
                        "verses_translate_name": "Verses",
                        "verses_number": "12",
                        "arabic_name": "فِيهَا عَيْنٌ جَارِيَةٌ",
                        "translated_name": "There is a stream of running water in it;"
                    },
