                    {
                        "id": 5520,
                        "chapter_id": 74,
                        "verses_translate_name": "Verses",
                        "verses_number": "25",
                        "arabic_name": "إِنْ هَـٰذَآ إِلَّا قَوْلُ ٱلْبَشَرِ",
                        "translated_name": "Nothing more than the speech of a man!\""
