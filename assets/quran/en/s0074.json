                    {
                        "id": 5502,
                        "chapter_id": 74,
                        "verses_translate_name": "Verses",
                        "verses_number": "7",
                        "arabic_name": "وَلِرَبِّكَ فَٱصْبِرْ",
                        "translated_name": "And persevere in the way of your Lord."
                    },
                    {
                        "id": 5503,
                        "chapter_id": 74,
                        "verses_translate_name": "Verses",
                        "verses_number": "8",
                        "arabic_name": "فَإِذَا نُقِرَ فِى ٱلنَّاقُورِ",
                        "translated_name": "For when the trumpet blows"
                    },
                    {
                        "id": 5504,
                        "chapter_id": 74,
                        "verses_translate_name": "Verses",
                        "verses_number": "9",
                        "arabic_name": "فَذَٰلِكَ يَوْمَئِذٍ يَوْمٌ عَسِيرٌ",
                        "translated_name": "It will be a day of distress,"
                    },
                    {
                        "id": 5505,
                        "chapter_id": 74,
                        "verses_translate_name": "Verses",
                        "verses_number": "10",
                        "arabic_name": "عَلَى ٱلْكَـٰفِرِينَ غَيْرُ يَسِيرٍ",
                        "translated_name": "Dolorous for the unbelievers."
                    },
                    {
                        "id": 5506,
                        "chapter_id": 74,
                        "verses_translate_name": "Verses",
                        "verses_number": "11",
                        "arabic_name": "ذَرْنِى وَمَنْ خَلَقْتُ وَحِيدًا",
                        "translated_name": "Leave him to Me whom I created alone,"
                    },
                    {
                        "id": 5507,
                        "chapter_id": 74,
                        "verses_translate_name": "Verses",
                        "verses_number": "12",
                        "arabic_name": "وَجَعَلْتُ لَهُۥ مَالًا مَّمْدُودًا",
                        "translated_name": "And gave him abundant wealth"
