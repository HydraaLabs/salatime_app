                        "chapter_id": 74,
                        "verses_translate_name": "Verses",
                        "verses_number": "33",
                        "arabic_name": "وَٱلَّيْلِ إِذْ أَدْبَرَ",
                        "translated_name": "And the night when on the wane,"
