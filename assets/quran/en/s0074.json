                    {
                        "id": 5508,
                        "chapter_id": 74,
                        "verses_translate_name": "Verses",
                        "verses_number": "13",
                        "arabic_name": "وَبَنِينَ شُهُودًا",
                        "translated_name": "And sons always present by his side,"
