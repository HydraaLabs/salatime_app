                    {
                        "id": 5509,
                        "chapter_id": 74,
                        "verses_translate_name": "Verses",
                        "verses_number": "14",
                        "arabic_name": "وَمَهَّدتُّ لَهُۥ تَمْهِيدًا",
                        "translated_name": "And made things easy for them."
                    },
                    {
                        "id": 5510,
                        "chapter_id": 74,
                        "verses_translate_name": "Verses",
                        "verses_number": "15",
                        "arabic_name": "ثُمَّ يَطْمَعُ أَنْ أَزِيدَ",
                        "translated_name": "Yet he wants that I should give him more."
                    },
                    {
                        "id": 5511,
                        "chapter_id": 74,
                        "verses_translate_name": "Verses",
                        "verses_number": "16",
                        "arabic_name": "كَلَّآ ۖ إِنَّهُۥ كَانَ لِـَٔايَـٰتِنَا عَنِيدًا",
                        "translated_name": "Never. He is refractory of Our signs."
                    },
