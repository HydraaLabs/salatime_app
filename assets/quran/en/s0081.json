                        "verses_translate_name": "Verses",
                        "verses_number": "8",
                        "arabic_name": "وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ",
                        "translated_name": "And the little girl buried alive is asked"
                    },
                    {
                        "id": 5809,
                        "chapter_id": 81,
                        "verses_translate_name": "Verses",
                        "verses_number": "9",
                        "arabic_name": "بِأَىِّ ذَنۢبٍ قُتِلَتْ",
                        "translated_name": "For what crime she was put to death;"
                    },
                    {
                        "id": 5810,
                        "chapter_id": 81,
                        "verses_translate_name": "Verses",
                        "verses_number": "10",
                        "arabic_name": "وَإِذَا ٱلصُّحُفُ نُشِرَتْ",
                        "translated_name": "When the ledgers are laid open,"
                    },
                    {
                        "id": 5811,
                        "chapter_id": 81,
                        "verses_translate_name": "Verses",
                        "verses_number": "11",
                        "arabic_name": "وَإِذَا ٱلسَّمَآءُ كُشِطَتْ",
                        "translated_name": "The curtain drawn back from the skies,"
                    },
                    {
                        "id": 5812,
