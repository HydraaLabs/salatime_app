                    {
                        "id": 5680,
                        "chapter_id": 78,
                        "verses_translate_name": "Verses",
                        "verses_number": "8",
                        "arabic_name": "وَخَلَقْنَـٰكُمْ أَزْوَٰجًا",
                        "translated_name": "We created you in pairs,"
                    },
                    {
                        "id": 5681,
                        "chapter_id": 78,
                        "verses_translate_name": "Verses",
                        "verses_number": "9",
                        "arabic_name": "وَجَعَلْنَا نَوْمَكُمْ سُبَاتًا",
                        "translated_name": "And made sleep for you to rest,"
                    },
                    {
                        "id": 5682,
                        "chapter_id": 78,
                        "verses_translate_name": "Verses",
                        "verses_number": "10",
                        "arabic_name": "وَجَعَلْنَا ٱلَّيْلَ لِبَاسًا",
                        "translated_name": "The night a covering,"
                    },
                    {
                        "id": 5683,
                        "chapter_id": 78,
                        "verses_translate_name": "Verses",
                        "verses_number": "11",
                        "arabic_name": "وَجَعَلْنَا ٱلنَّهَارَ مَعَاشًا",
                        "translated_name": "And the day for seeking livelihood."
                    },
                    {
                        "id": 5684,
                        "chapter_id": 78,
                        "verses_translate_name": "Verses",
                        "verses_number": "12",
                        "arabic_name": "وَبَنَيْنَا فَوْقَكُمْ سَبْعًا شِدَادًا",
                        "translated_name": "We raised over you several secure (skies),"
                    },
                    {
                        "id": 5685,
                        "chapter_id": 78,
                        "verses_translate_name": "Verses",
                        "verses_number": "13",
                        "arabic_name": "وَجَعَلْنَا سِرَاجًا وَهَّاجًا",
                        "translated_name": "And placed a lamp therein brightly burning."
                    },
                    {
                        "id": 5686,
                        "chapter_id": 78,
                        "verses_translate_name": "Verses",
                        "verses_number": "14",
                        "arabic_name": "وَأَنزَلْنَا مِنَ ٱلْمُعْصِرَٰتِ مَآءً ثَجَّاجًا",
                        "translated_name": "And We sent down rain from water-laden clouds pouring in torrents"
                    },
