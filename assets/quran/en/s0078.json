                        "id": 5687,
                        "chapter_id": 78,
                        "verses_translate_name": "Verses",
                        "verses_number": "15",
                        "arabic_name": "لِّنُخْرِجَ بِهِۦ حَبًّا وَنَبَاتًا",
                        "translated_name": "That We may produce from it grain and vegetation,"
                    },
                    {
                        "id": 5688,
                        "chapter_id": 78,
                        "verses_translate_name": "Verses",
                        "verses_number": "16",
                        "arabic_name": "وَجَنَّـٰتٍ أَلْفَافًا",
                        "translated_name": "And orchards full of trees and interlacing boughs."
                    },
                    {
                        "id": 5689,
                        "chapter_id": 78,
                        "verses_translate_name": "Verses",
                        "verses_number": "17",
                        "arabic_name": "إِنَّ يَوْمَ ٱلْفَصْلِ كَانَ مِيقَـٰتًا",
                        "translated_name": "Surely a time is fixed for the Day of Judgement."
                    },
                    {
                        "id": 5690,
                        "chapter_id": 78,
                        "verses_translate_name": "Verses",
                        "verses_number": "18",
                        "arabic_name": "يَوْمَ يُنفَخُ فِى ٱلصُّورِ فَتَأْتُونَ أَفْوَاجًا",
                        "translated_name": "The day the trumpet blast is sounded you will come in hordes;"
                    },
                    {
                        "id": 5691,
                        "chapter_id": 78,
                        "verses_translate_name": "Verses",
                        "verses_number": "19",
                        "arabic_name": "وَفُتِحَتِ ٱلسَّمَآءُ فَكَانَتْ أَبْوَٰبًا",
                        "translated_name": "The heavens will be opened wide and turn into so many doors,"
                    },
                    {
                        "id": 5692,
                        "chapter_id": 78,
                        "verses_translate_name": "Verses",
                        "verses_number": "20",
                        "arabic_name": "وَسُيِّرَتِ ٱلْجِبَالُ فَكَانَتْ سَرَابًا",
                        "translated_name": "The mountains put in motion turning into a mirage."
                    },
                    {
                        "id": 5693,
                        "chapter_id": 78,
                        "verses_translate_name": "Verses",
                        "verses_number": "21",
                        "arabic_name": "إِنَّ جَهَنَّمَ كَانَتْ مِرْصَادًا",
                        "translated_name": "Certainly Hell lies in wait,"
                    },
                    {
                        "id": 5694,
                        "chapter_id": 78,
                        "verses_translate_name": "Verses",
                        "verses_number": "22",
                        "arabic_name": "لِّلطَّـٰغِينَ مَـَٔابًا",
                        "translated_name": "The rebels' abode,"
                    },
