                    {
                        "id": 5678,
                        "chapter_id": 78,
                        "verses_translate_name": "Verses",
                        "verses_number": "6",
                        "arabic_name": "أَلَمْ نَجْعَلِ ٱلْأَرْضَ مِهَـٰدًا",
                        "translated_name": "Did We not make the earth a spreading,"
                    },
                    {
                        "id": 5679,
                        "chapter_id": 78,
                        "verses_translate_name": "Verses",
                        "verses_number": "7",
                        "arabic_name": "وَٱلْجِبَالَ أَوْتَادًا",
                        "translated_name": "The mountains tent-pins?"
