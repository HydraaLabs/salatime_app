                        "id": 5677,
                        "chapter_id": 78,
                        "verses_translate_name": "Verses",
                        "verses_number": "5",
                        "arabic_name": "ثُمَّ كَلَّا سَيَعْلَمُونَ",
                        "translated_name": "They will indeed come to know soon."
