                        "id": 5701,
                        "chapter_id": 78,
                        "verses_translate_name": "Verses",
                        "verses_number": "29",
                        "arabic_name": "وَكُلَّ شَىْءٍ أَحْصَيْنَـٰهُ كِتَـٰبًا",
                        "translated_name": "We have kept account of everything in a book."
                    },
