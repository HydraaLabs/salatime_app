                        "translated_name": "About which they have been differing?"
                    },
                    {
                        "id": 5676,
                        "chapter_id": 78,
                        "verses_translate_name": "Verses",
                        "verses_number": "4",
                        "arabic_name": "كَلَّا سَيَعْلَمُونَ",
                        "translated_name": "Indeed they will come to know soon;"
