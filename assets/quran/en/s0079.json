                        "verses_translate_name": "Verses",
                        "verses_number": "2",
                        "arabic_name": "وَٱلنَّـٰشِطَـٰتِ نَشْطًا",
                        "translated_name": "And those who undo the bonds gently,"
                    },
                    {
                        "id": 5715,
                        "chapter_id": 79,
                        "verses_translate_name": "Verses",
                        "verses_number": "3",
                        "arabic_name": "وَٱلسَّـٰبِحَـٰتِ سَبْحًا",
                        "translated_name": "And those who glide swimmingly,"
                    },
                    {
                        "id": 5716,
                        "chapter_id": 79,
                        "verses_translate_name": "Verses",
                        "verses_number": "4",
                        "arabic_name": "فَٱلسَّـٰبِقَـٰتِ سَبْقًا",
                        "translated_name": "Then outpace the others swiftly"
                    },
                    {
                        "id": 5717,
                        "chapter_id": 79,
                        "verses_translate_name": "Verses",
                        "verses_number": "5",
                        "arabic_name": "فَٱلْمُدَبِّرَٰتِ أَمْرًا",
                        "translated_name": "And direct affairs by command,"
                    },
                    {
                        "id": 5718,
                        "chapter_id": 79,
                        "verses_translate_name": "Verses",
                        "verses_number": "6",
                        "arabic_name": "يَوْمَ تَرْجُفُ ٱلرَّاجِفَةُ",
                        "translated_name": "The day the convulsive (first blast) shatters convulsively"
                    },
                    {
                        "id": 5719,
                        "chapter_id": 79,
                        "verses_translate_name": "Verses",
                        "verses_number": "7",
                        "arabic_name": "تَتْبَعُهَا ٱلرَّادِفَةُ",
                        "translated_name": "Followed by the second blast,"
                    },
                    {
                        "id": 5720,
                        "chapter_id": 79,
                        "verses_translate_name": "Verses",
                        "verses_number": "8",
                        "arabic_name": "قُلُوبٌ يَوْمَئِذٍ وَاجِفَةٌ",
                        "translated_name": "Hearts will pound loudly on that day,"
                    },
                    {
                        "id": 5721,
                        "chapter_id": 79,
                        "verses_translate_name": "Verses",
                        "verses_number": "9",
                        "arabic_name": "أَبْصَـٰرُهَا خَـٰشِعَةٌ",
                        "translated_name": "Eyes be lowered in submission."
                    },
                    {
                        "id": 5722,
                        "chapter_id": 79,
                        "verses_translate_name": "Verses",
                        "verses_number": "10",
                        "arabic_name": "يَقُولُونَ أَءِنَّا لَمَرْدُودُونَ فِى ٱلْحَافِرَةِ",
                        "translated_name": "They say: \"Shall we go back to our original state"
                    },
                    {
                        "id": 5723,
                        "chapter_id": 79,
                        "verses_translate_name": "Verses",
                        "verses_number": "11",
                        "arabic_name": "أَءِذَا كُنَّا عِظَـٰمًا نَّخِرَةً",
                        "translated_name": "After having turned to carious bones?\""
                    },
                    {
                        "id": 5724,
                        "chapter_id": 79,
                        "verses_translate_name": "Verses",
                        "verses_number": "12",
                        "arabic_name": "قَالُوا۟ تِلْكَ إِذًا كَرَّةٌ خَاسِرَةٌ",
                        "translated_name": "They say: \"Then this returning will be a dead loss.\""
                    },
                    {
                        "id": 5725,
                        "chapter_id": 79,
                        "verses_translate_name": "Verses",
                        "verses_number": "13",
                        "arabic_name": "فَإِنَّمَا هِىَ زَجْرَةٌ وَٰحِدَةٌ",
                        "translated_name": "It will only be a single blast,"
                    },
                    {
                        "id": 5726,
                        "chapter_id": 79,
                        "verses_translate_name": "Verses",
                        "verses_number": "14",
                        "arabic_name": "فَإِذَا هُم بِٱلسَّاهِرَةِ",
                        "translated_name": "And they will wake up suddenly."
                    },
                    {
                        "id": 5727,
                        "chapter_id": 79,
                        "verses_translate_name": "Verses",
                        "verses_number": "15",
                        "arabic_name": "هَلْ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ",
                        "translated_name": "Has the story of Moses come to you"
                    }
                ],
                "page_arabic_ayah": "وَٱلنَّـٰزِعَـٰتِ غَرْقًا (١)  وَٱلنَّـٰشِطَـٰتِ نَشْطًا (٢)  وَٱلسَّـٰبِحَـٰتِ سَبْحًا (٣)  فَٱلسَّـٰبِقَـٰتِ سَبْقًا (٤)  فَٱلْمُدَبِّرَٰتِ أَمْرًا (٥)  يَوْمَ تَرْجُفُ ٱلرَّاجِفَةُ (٦)  تَتْبَعُهَا ٱلرَّادِفَةُ (٧)  قُلُوبٌ يَوْمَئِذٍ وَاجِفَةٌ (٨)  أَبْصَـٰرُهَا خَـٰشِعَةٌ (٩)  يَقُولُونَ أَءِنَّا لَمَرْدُودُونَ فِى ٱلْحَافِرَةِ (١٠)  أَءِذَا كُنَّا عِظَـٰمًا نَّخِرَةً (١١)  قَالُوا۟ تِلْكَ إِذًا كَرَّةٌ خَاسِرَةٌ (١٢)  فَإِنَّمَا هِىَ زَجْرَةٌ وَٰحِدَةٌ (١٣)  فَإِذَا هُم بِٱلسَّاهِرَةِ (١٤)  هَلْ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ (١٥)",
