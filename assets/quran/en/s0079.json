                    {
                        "id": 5735,
                        "chapter_id": 79,
                        "verses_translate_name": "Verses",
                        "verses_number": "23",
                        "arabic_name": "فَحَشَرَ فَنَادَىٰ",
                        "translated_name": "And assembled (his council) and proclaimed,"
                    },
                    {
                        "id": 5736,
                        "chapter_id": 79,
                        "verses_translate_name": "Verses",
                        "verses_number": "24",
                        "arabic_name": "فَقَالَ أَنَا۠ رَبُّكُمُ ٱلْأَعْلَىٰ",
                        "translated_name": "Saying: \"I am alone your lord, the highest of them all.\""
                    },
                    {
                        "id": 5737,
                        "chapter_id": 79,
                        "verses_translate_name": "Verses",
                        "verses_number": "25",
                        "arabic_name": "فَأَخَذَهُ ٱللَّهُ نَكَالَ ٱلْـَٔاخِرَةِ وَٱلْأُولَىٰٓ",
                        "translated_name": "So God seized him for the punishment of the Hereafter and this world."
                    },
                    {
                        "id": 5738,
                        "chapter_id": 79,
                        "verses_translate_name": "Verses",
                        "verses_number": "26",
                        "arabic_name": "إِنَّ فِى ذَٰلِكَ لَعِبْرَةً لِّمَن يَخْشَىٰٓ",
                        "translated_name": "Truly there is a lesson in this for those who fear (the consequences)."
                    },
                    {
                        "id": 5739,
                        "chapter_id": 79,
                        "verses_translate_name": "Verses",
                        "verses_number": "27",
                        "arabic_name": "ءَأَنتُمْ أَشَدُّ خَلْقًا أَمِ ٱلسَّمَآءُ ۚ بَنَىٰهَا",
                        "translated_name": "Are you more difficult to create or the heavens? He built it,"
                    },
                    {
                        "id": 5740,
                        "chapter_id": 79,
                        "verses_translate_name": "Verses",
                        "verses_number": "28",
                        "arabic_name": "رَفَعَ سَمْكَهَا فَسَوَّىٰهَا",
                        "translated_name": "Raised it high, proportioned it,"
                    },
                    {
                        "id": 5741,
                        "chapter_id": 79,
                        "verses_translate_name": "Verses",
                        "verses_number": "29",
                        "arabic_name": "وَأَغْطَشَ لَيْلَهَا وَأَخْرَجَ ضُحَىٰهَا",
                        "translated_name": "Gave darkness to its night, and brightness to its day;"
                    },
                    {
                        "id": 5742,
                        "chapter_id": 79,
                        "verses_translate_name": "Verses",
                        "verses_number": "30",
                        "arabic_name": "وَٱلْأَرْضَ بَعْدَ ذَٰلِكَ دَحَىٰهَآ",
                        "translated_name": "And afterwards spread out the earth."
                    },
                    {
                        "id": 5743,
                        "chapter_id": 79,
                        "verses_translate_name": "Verses",
                        "verses_number": "31",
                        "arabic_name": "أَخْرَجَ مِنْهَا مَآءَهَا وَمَرْعَىٰهَا",
                        "translated_name": "He brought out its water and its pastures from it,"
                    },
                    {
                        "id": 5744,
                        "chapter_id": 79,
                        "verses_translate_name": "Verses",
                        "verses_number": "32",
                        "arabic_name": "وَٱلْجِبَالَ أَرْسَىٰهَا",
                        "translated_name": "And stabilized the mountains"
                    },
                    {
                        "id": 5745,
                        "chapter_id": 79,
                        "verses_translate_name": "Verses",
                        "verses_number": "33",
