                    {
                        "id": 4983,
                        "chapter_id": 56,
                        "verses_translate_name": "Verses",
                        "verses_number": "4",
                        "arabic_name": "إِذَا رُجَّتِ ٱلْأَرْضُ رَجًّا",
                        "translated_name": "When the earth is shaken up convulsively,"
                    },
                    {
                        "id": 4984,
                        "chapter_id": 56,
                        "verses_translate_name": "Verses",
                        "verses_number": "5",
                        "arabic_name": "وَبُسَّتِ ٱلْجِبَالُ بَسًّا",
                        "translated_name": "The mountains bruised and crushed,"
                    },
                    {
                        "id": 4985,
                        "chapter_id": 56,
                        "verses_translate_name": "Verses",
                        "verses_number": "6",
                        "arabic_name": "فَكَانَتْ هَبَآءً مُّنۢبَثًّا",
                        "translated_name": "Turned to dust, floating in the air,"
                    },
                    {
                        "id": 4986,
                        "chapter_id": 56,
                        "verses_translate_name": "Verses",
                        "verses_number": "7",
                        "arabic_name": "وَكُنتُمْ أَزْوَٰجًا ثَلَـٰثَةً",
                        "translated_name": "You will become three categories:"
                    },
                    {
                        "id": 4987,
                        "chapter_id": 56,
                        "verses_translate_name": "Verses",
                        "verses_number": "8",
                        "arabic_name": "فَأَصْحَـٰبُ ٱلْمَيْمَنَةِ مَآ أَصْحَـٰبُ ٱلْمَيْمَنَةِ",
                        "translated_name": "Those of the right hand -- how (happy) will be those of the right hand!"
                    },
                    {
                        "id": 4988,
                        "chapter_id": 56,
                        "verses_translate_name": "Verses",
                        "verses_number": "9",
                        "arabic_name": "وَأَصْحَـٰبُ ٱلْمَشْـَٔمَةِ مَآ أَصْحَـٰبُ ٱلْمَشْـَٔمَةِ",
                        "translated_name": "Then those of the left hand -- how (unhappy) will be those of the left hand!"
                    },
                    {
                        "id": 4989,
                        "chapter_id": 56,
                        "verses_translate_name": "Verses",
                        "verses_number": "10",
                        "arabic_name": "وَٱلسَّـٰبِقُونَ ٱلسَّـٰبِقُونَ",
                        "translated_name": "Then the foremost, how pre-excellent,"
                    },
                    {
                        "id": 4990,
