                        "chapter_id": 56,
                        "verses_translate_name": "Verses",
                        "verses_number": "12",
                        "arabic_name": "فِى جَنَّـٰتِ ٱلنَّعِيمِ",
                        "translated_name": "In gardens of tranquility;"
