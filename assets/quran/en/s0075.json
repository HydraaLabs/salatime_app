                        "verses_translate_name": "Verses",
                        "verses_number": "30",
                        "arabic_name": "إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمَسَاقُ",
                        "translated_name": "To your Lord then will be the driving."
                    },
                    {
                        "id": 5582,
                        "chapter_id": 75,
                        "verses_translate_name": "Verses",
                        "verses_number": "31",
                        "arabic_name": "فَلَا صَدَّقَ وَلَا صَلَّىٰ",
                        "translated_name": "For he neither believed nor prayed,"
                    },
                    {
                        "id": 5583,
                        "chapter_id": 75,
                        "verses_translate_name": "Verses",
