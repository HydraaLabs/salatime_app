                        "verses_number": "1",
                        "arabic_name": "لَآ أُقْسِمُ بِيَوْمِ ٱلْقِيَـٰمَةِ",
                        "translated_name": "I CALL TO WITNESS the Day of Resurrection,"
                    },
                    {
                        "id": 5553,
                        "chapter_id": 75,
                        "verses_translate_name": "Verses",
                        "verses_number": "2",
                        "arabic_name": "وَلَآ أُقْسِمُ بِٱلنَّفْسِ ٱللَّوَّامَةِ",
                        "translated_name": "And I call the reprehensive soul to witness:"
                    },
                    {
                        "id": 5554,
                        "chapter_id": 75,
                        "verses_translate_name": "Verses",
                        "verses_number": "3",
                        "arabic_name": "أَيَحْسَبُ ٱلْإِنسَـٰنُ أَلَّن نَّجْمَعَ عِظَامَهُۥ",
                        "translated_name": "Does man think We shall not put his bones together?"
                    },
                    {
                        "id": 5555,
                        "chapter_id": 75,
                        "verses_translate_name": "Verses",
                        "verses_number": "4",
                        "arabic_name": "بَلَىٰ قَـٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّىَ بَنَانَهُۥ",
                        "translated_name": "Surely We are able to reform even his finger-tips."
                    },
                    {
                        "id": 5556,
                        "chapter_id": 75,
                        "verses_translate_name": "Verses",
                        "verses_number": "5",
                        "arabic_name": "بَلْ يُرِيدُ ٱلْإِنسَـٰنُ لِيَفْجُرَ أَمَامَهُۥ",
                        "translated_name": "Yet man is sceptical of what is right before him."
                    },
                    {
                        "id": 5557,
                        "chapter_id": 75,
                        "verses_translate_name": "Verses",
                        "verses_number": "6",
                        "arabic_name": "يَسْـَٔلُ أَيَّانَ يَوْمُ ٱلْقِيَـٰمَةِ",
                        "translated_name": "He asks: \"When will the Day of Resurrection be?\""
                    },
                    {
                        "id": 5558,
                        "chapter_id": 75,
                        "verses_translate_name": "Verses",
                        "verses_number": "7",
                        "arabic_name": "فَإِذَا بَرِقَ ٱلْبَصَرُ",
                        "translated_name": "Yet when the eyes are dazzled,"
                    },
                    {
                        "id": 5559,
                        "chapter_id": 75,
                        "verses_translate_name": "Verses",
                        "verses_number": "8",
                        "arabic_name": "وَخَسَفَ ٱلْقَمَرُ",
                        "translated_name": "The moon eclipsed,"
                    },
                    {
                        "id": 5560,
                        "chapter_id": 75,
                        "verses_translate_name": "Verses",
                        "verses_number": "9",
                        "arabic_name": "وَجُمِعَ ٱلشَّمْسُ وَٱلْقَمَرُ",
                        "translated_name": "And the sun and moon are conjoined,"
                    },
                    {
                        "id": 5561,
                        "chapter_id": 75,
                        "verses_translate_name": "Verses",
                        "verses_number": "10",
                        "arabic_name": "يَقُولُ ٱلْإِنسَـٰنُ يَوْمَئِذٍ أَيْنَ ٱلْمَفَرُّ",
                        "translated_name": "That day man will say: \"Where can I find escape?\""
                    },
                    {
                        "id": 5562,
                        "chapter_id": 75,
                        "verses_translate_name": "Verses",
                        "verses_number": "11",
                        "arabic_name": "كَلَّا لَا وَزَرَ",
                        "translated_name": "Never so, for there will be no escape."
                    },
                    {
                        "id": 5563,
                        "chapter_id": 75,
                        "verses_translate_name": "Verses",
                        "verses_number": "12",
                        "arabic_name": "إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمُسْتَقَرُّ",
                        "translated_name": "With your Lord alone will be the retreat on that day."
                    },
                    {
                        "id": 5564,
                        "chapter_id": 75,
                        "verses_translate_name": "Verses",
                        "verses_number": "13",
                        "arabic_name": "يُنَبَّؤُا۟ ٱلْإِنسَـٰنُ يَوْمَئِذٍۭ بِمَا قَدَّمَ وَأَخَّرَ",
                        "translated_name": "Then man will be told what he had sent ahead (of good) and what he had left behind."
                    },
                    {
                        "id": 5565,
                        "chapter_id": 75,
                        "verses_translate_name": "Verses",
                        "verses_number": "14",
                        "arabic_name": "بَلِ ٱلْإِنسَـٰنُ عَلَىٰ نَفْسِهِۦ بَصِيرَةٌ",
                        "translated_name": "In fact man is a witness against himself,"
                    },
                    {
                        "id": 5566,
                        "chapter_id": 75,
                        "verses_translate_name": "Verses",
                        "verses_number": "15",
                        "arabic_name": "وَلَوْ أَلْقَىٰ مَعَاذِيرَهُۥ",
                        "translated_name": "Whatever the excuses he may offer."
                    },
                    {
                        "id": 5567,
                        "chapter_id": 75,
                        "verses_translate_name": "Verses",
                        "verses_number": "16",
                        "arabic_name": "لَا تُحَرِّكْ بِهِۦ لِسَانَكَ لِتَعْجَلَ بِهِۦٓ",
                        "translated_name": "Do not forestall (the revelation before its completion) by acting in haste."
                    },
                    {
                        "id": 5568,
                        "chapter_id": 75,
                        "verses_translate_name": "Verses",
                        "verses_number": "17",
                        "arabic_name": "إِنَّ عَلَيْنَا جَمْعَهُۥ وَقُرْءَانَهُۥ",
                        "translated_name": "Surely its collection and recitation are Our responsibility."
                    },
                    {
                        "id": 5569,
                        "chapter_id": 75,
                        "verses_translate_name": "Verses",
                        "verses_number": "18",
                        "arabic_name": "فَإِذَا قَرَأْنَـٰهُ فَٱتَّبِعْ قُرْءَانَهُۥ",
                        "translated_name": "So, as We recite it, follow its reading."
                    },
                    {
                        "id": 5570,
                        "chapter_id": 75,
                        "verses_translate_name": "Verses",
                        "verses_number": "19",
                        "arabic_name": "ثُمَّ إِنَّ عَلَيْنَا بَيَانَهُۥ",
                        "translated_name": "The exposition of its meaning surely rests on Us."
                    }
                ],
                "page_arabic_ayah": "لَآ أُقْسِمُ بِيَوْمِ ٱلْقِيَـٰمَةِ (١)  وَلَآ أُقْسِمُ بِٱلنَّفْسِ ٱللَّوَّامَةِ (٢)  أَيَحْسَبُ ٱلْإِنسَـٰنُ أَلَّن نَّجْمَعَ عِظَامَهُۥ (٣)  بَلَىٰ قَـٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّىَ بَنَانَهُۥ (٤)  بَلْ يُرِيدُ ٱلْإِنسَـٰنُ لِيَفْجُرَ أَمَامَهُۥ (٥)  يَسْـَٔلُ أَيَّانَ يَوْمُ ٱلْقِيَـٰمَةِ (٦)  فَإِذَا بَرِقَ ٱلْبَصَرُ (٧)  وَخَسَفَ ٱلْقَمَرُ (٨)  وَجُمِعَ ٱلشَّمْسُ وَٱلْقَمَرُ (٩)  يَقُولُ ٱلْإِنسَـٰنُ يَوْمَئِذٍ أَيْنَ ٱلْمَفَرُّ (١٠)  كَلَّا لَا وَزَرَ (١١)  إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمُسْتَقَرُّ (١٢)  يُنَبَّؤُا۟ ٱلْإِنسَـٰنُ يَوْمَئِذٍۭ بِمَا قَدَّمَ وَأَخَّرَ (١٣)  بَلِ ٱلْإِنسَـٰنُ عَلَىٰ نَفْسِهِۦ بَصِيرَةٌ (١٤)  وَلَوْ أَلْقَىٰ مَعَاذِيرَهُۥ (١٥)  لَا تُحَرِّكْ بِهِۦ لِسَانَكَ لِتَعْجَلَ بِهِۦٓ (١٦)  إِنَّ عَلَيْنَا جَمْعَهُۥ وَقُرْءَانَهُۥ (١٧)  فَإِذَا قَرَأْنَـٰهُ فَٱتَّبِعْ قُرْءَانَهُۥ (١٨)  ثُمَّ إِنَّ عَلَيْنَا بَيَانَهُۥ (١٩)",
