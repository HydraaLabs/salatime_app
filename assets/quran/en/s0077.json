                        "verses_translate_name": "Verses",
                        "verses_number": "5",
                        "arabic_name": "فَٱلْمُلْقِيَـٰتِ ذِكْرًا",
                        "translated_name": "And those that bring down the Reminder"
                    },
                    {
                        "id": 5628,
                        "chapter_id": 77,
                        "verses_translate_name": "Verses",
                        "verses_number": "6",
                        "arabic_name": "عُذْرًا أَوْ نُذْرًا",
                        "translated_name": "To end all argument or to warn."
                    },
                    {
                        "id": 5629,
                        "chapter_id": 77,
                        "verses_translate_name": "Verses",
                        "verses_number": "7",
                        "arabic_name": "إِنَّمَا تُوعَدُونَ لَوَٰقِعٌ",
                        "translated_name": "What is promised will surely come to pass."
                    },
                    {
                        "id": 5630,
                        "chapter_id": 77,
                        "verses_translate_name": "Verses",
                        "verses_number": "8",
                        "arabic_name": "فَإِذَا ٱلنُّجُومُ طُمِسَتْ",
                        "translated_name": "When the stars are obliterated,"
                    },
                    {
                        "id": 5631,
                        "chapter_id": 77,
                        "verses_translate_name": "Verses",
                        "verses_number": "9",
                        "arabic_name": "وَإِذَا ٱلسَّمَآءُ فُرِجَتْ",
                        "translated_name": "The heavens split asunder,"
                    },
                    {
                        "id": 5632,
                        "chapter_id": 77,
                        "verses_translate_name": "Verses",
                        "verses_number": "10",
                        "arabic_name": "وَإِذَا ٱلْجِبَالُ نُسِفَتْ",
                        "translated_name": "The mountains reduced to dust and blown away,"
                    },
                    {
                        "id": 5633,
                        "chapter_id": 77,
                        "verses_translate_name": "Verses",
                        "verses_number": "11",
                        "arabic_name": "وَإِذَا ٱلرُّسُلُ أُقِّتَتْ",
                        "translated_name": "And when the time comes for raising the little girls (buried alive) --"
                    },
                    {
                        "id": 5634,
                        "chapter_id": 77,
                        "verses_translate_name": "Verses",
                        "verses_number": "12",
                        "arabic_name": "لِأَىِّ يَوْمٍ أُجِّلَتْ",
                        "translated_name": "For what day is that time fixed?"
                    },
                    {
                        "id": 5635,
                        "chapter_id": 77,
                        "verses_translate_name": "Verses",
                        "verses_number": "13",
                        "arabic_name": "لِيَوْمِ ٱلْفَصْلِ",
                        "translated_name": "The Day of Judgement."
                    },
                    {
                        "id": 5636,
                        "chapter_id": 77,
                        "verses_translate_name": "Verses",
                        "verses_number": "14",
                        "arabic_name": "وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلْفَصْلِ",
                        "translated_name": "How will you comprehend what the Day of Judgement is?"
                    },
                    {
                        "id": 5637,
                        "chapter_id": 77,
                        "verses_translate_name": "Verses",
                        "verses_number": "15",
                        "arabic_name": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
                        "translated_name": "Alas the woe that day for those who deny!"
                    },
                    {
                        "id": 5638,
                        "chapter_id": 77,
                        "verses_translate_name": "Verses",
                        "verses_number": "16",
                        "arabic_name": "أَلَمْ نُهْلِكِ ٱلْأَوَّلِينَ",
                        "translated_name": "Have We not destroyed the earlier generations?"
                    },
                    {
                        "id": 5639,
                        "chapter_id": 77,
                        "verses_translate_name": "Verses",
                        "verses_number": "17",
                        "arabic_name": "ثُمَّ نُتْبِعُهُمُ ٱلْـَٔاخِرِينَ",
                        "translated_name": "So shall We make the later ones to follow them."
                    },
                    {
                        "id": 5640,
                        "chapter_id": 77,
                        "verses_translate_name": "Verses",
                        "verses_number": "18",
                        "arabic_name": "كَذَٰلِكَ نَفْعَلُ بِٱلْمُجْرِمِينَ",
                        "translated_name": "That is what We shall do to those who are guilty of crime."
                    },
