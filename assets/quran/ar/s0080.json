                        "arabic_name": "عَبَسَ وَتَوَلَّىٰٓ",
                        "translated_name": "«عبس» النبي: كلح وجهه «وتولى» أعرضَ لأجل:"
                    },
                    {
                        "id": 5760,
                        "chapter_id": 80,
                        "verses_translate_name": "الآيات",
                        "verses_number": "2",
                        "arabic_name": "أَن جَآءَهُ ٱلْأَعْمَىٰ",
                        "translated_name": "(أن جاءه الأعمى) عبد الله بن أم مكتوم فقطعه عما هو مشغول به ممن يرجو إسلامه من أشراف قريش الذين هو حريص على إسلامهم، ولم يدر الأعمى أنه مشغول بذلك فناداه: علمني مما علمك الله، فانصرف النبي صلى الله عليه وسلم إلى بيته فعوتب في ذلك بما نزل في هذه السورة، فكان بعد ذلك يقول له إذا جاء: \"\" مرحبا بمن عاتبني فيه ربي \"\" ويبسط له رداءه."
                    },
                    {
                        "id": 5761,
                        "chapter_id": 80,
                        "verses_translate_name": "الآيات",
                        "verses_number": "3",
                        "arabic_name": "وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ",
                        "translated_name": "«وما يُدريك» يعلمك «لعله يزكى» فيه إدغام التاء في الأصل في الزاي، أي يتطهر من الذنوب بما يسمع منك."
                    },
                    {
                        "id": 5762,
                        "chapter_id": 80,
                        "verses_translate_name": "الآيات",
                        "verses_number": "4",
                        "arabic_name": "أَوْ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكْرَىٰٓ",
                        "translated_name": "«أو يذكَّر» فيه إدغام التاء في الأصل في الذال أي يتعظ «فتنفعُه الذكرى» العظة المسموعة منك وفي قراءة بنصب تنفعه جواب الترجي."
                    },
                    {
                        "id": 5763,
                        "chapter_id": 80,
                        "verses_translate_name": "الآيات",
                        "verses_number": "5",
                        "arabic_name": "أَمَّا مَنِ ٱسْتَغْنَىٰ",
                        "translated_name": "«أما من استغنى» بالمال."
                    },
                    {
                        "id": 5764,
                        "chapter_id": 80,
                        "verses_translate_name": "الآيات",
                        "verses_number": "6",
                        "arabic_name": "فَأَنتَ لَهُۥ تَصَدَّىٰ",
                        "translated_name": "«فأنت له تصدى» وفي قراءة بتشديد الصاد بإدغام التاء الثانية في الأصل فيها: تقبل وتتعرض."
                    },
                    {
                        "id": 5765,
                        "chapter_id": 80,
                        "verses_translate_name": "الآيات",
                        "verses_number": "7",
                        "arabic_name": "وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ",
                        "translated_name": "«وما عليك ألا يزكى» يؤمن."
                    },
                    {
                        "id": 5766,
                        "chapter_id": 80,
                        "verses_translate_name": "الآيات",
                        "verses_number": "8",
                        "arabic_name": "وَأَمَّا مَن جَآءَكَ يَسْعَىٰ",
                        "translated_name": "«وأما من جاءك يسعى» حال من فاعل جاء."
                    },
                    {
                        "id": 5767,
                        "chapter_id": 80,
                        "verses_translate_name": "الآيات",
                        "verses_number": "9",
                        "arabic_name": "وَهُوَ يَخْشَىٰ",
                        "translated_name": "«وهو يخشى» الله حال من فاعل يسعى وهو الأعمى."
                    },
                    {
                        "id": 5768,
                        "chapter_id": 80,
                        "verses_translate_name": "الآيات",
                        "verses_number": "10",
                        "arabic_name": "فَأَنتَ عَنْهُ تَلَهَّىٰ",
                        "translated_name": "«فأنت عنه تَلَهَّى» فيه حذف التاء الأخرى في الأصل أي تتشاغل."
                    },
                    {
                        "id": 5769,
                        "chapter_id": 80,
                        "verses_translate_name": "الآيات",
                        "verses_number": "11",
                        "arabic_name": "كَلَّآ إِنَّهَا تَذْكِرَةٌ",
                        "translated_name": "«كلا» لا تفعل مثل ذلك «إنها» أي السورة أو الآيات «تذكرة» عظة للخلق."
                    },
                    {
                        "id": 5770,
                        "chapter_id": 80,
                        "verses_translate_name": "الآيات",
                        "verses_number": "12",
                        "arabic_name": "فَمَن شَآءَ ذَكَرَهُۥ",
                        "translated_name": "«فمن شاء ذكره» حفظ ذلك فاتعظ به."
                    },
                    {
                        "id": 5771,
                        "chapter_id": 80,
                        "verses_translate_name": "الآيات",
                        "verses_number": "13",
                        "arabic_name": "فِى صُحُفٍ مُّكَرَّمَةٍ",
                        "translated_name": "«في صحف» خبر ثان لأنها وما قبله اعتراض «مكرمة» عند الله."
                    },
                    {
                        "id": 5772,
                        "chapter_id": 80,
                        "verses_translate_name": "الآيات",
                        "verses_number": "14",
                        "arabic_name": "مَّرْفُوعَةٍ مُّطَهَّرَةٍۭ",
                        "translated_name": "«مرفوعة» في السماء «مطهرة» منزهة عن مس الشياطين."
                    },
                    {
                        "id": 5773,
                        "chapter_id": 80,
                        "verses_translate_name": "الآيات",
                        "verses_number": "15",
                        "arabic_name": "بِأَيْدِى سَفَرَةٍ",
                        "translated_name": "«بأيدي سفرة» كتبة ينسخونها من اللوح المحفوظ."
                    },
                    {
                        "id": 5774,
                        "chapter_id": 80,
                        "verses_translate_name": "الآيات",
                        "verses_number": "16",
                        "arabic_name": "كِرَامٍۭ بَرَرَةٍ",
                        "translated_name": "«كرام بررة» مطيعين لله تعالى وهم الملائكة."
                    },
                    {
                        "id": 5775,
                        "chapter_id": 80,
                        "verses_translate_name": "الآيات",
                        "verses_number": "17",
                        "arabic_name": "قُتِلَ ٱلْإِنسَـٰنُ مَآ أَكْفَرَهُۥ",
                        "translated_name": "«قتل الإنسان» لعن الكافر «ما أكفره» استفهام توبيخ، أي ما حمله على الكفر."
                    },
                    {
                        "id": 5776,
                        "chapter_id": 80,
                        "verses_translate_name": "الآيات",
                        "verses_number": "18",
                        "arabic_name": "مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ",
                        "translated_name": "«من أي شيءٍ خلقه» استفهام تقرير، ثم بينه فقال:"
                    },
                    {
                        "id": 5777,
                        "chapter_id": 80,
                        "verses_translate_name": "الآيات",
                        "verses_number": "19",
                        "arabic_name": "مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ",
                        "translated_name": "«من نطفة خلقه فقدره» علقة ثم مضغة إلى آخر خلقه."
                    },
                    {
                        "id": 5778,
                        "chapter_id": 80,
                        "verses_translate_name": "الآيات",
                        "verses_number": "20",
                        "arabic_name": "ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ",
                        "translated_name": "«ثم السبيل» أي طريق خروجه من بطن أمه «يَسَّره»."
                    },
                    {
                        "id": 5779,
                        "chapter_id": 80,
                        "verses_translate_name": "الآيات",
                        "verses_number": "21",
                        "arabic_name": "ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥ",
                        "translated_name": "«ثم أماته فأقبره» جعله في قبر يستره."
                    },
                    {
                        "id": 5780,
                        "chapter_id": 80,
                        "verses_translate_name": "الآيات",
                        "verses_number": "22",
                        "arabic_name": "ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ",
                        "translated_name": "«ثم إذا شاء أنشره» للبعث."
                    },
                    {
                        "id": 5781,
                        "chapter_id": 80,
                        "verses_translate_name": "الآيات",
                        "verses_number": "23",
                        "arabic_name": "كَلَّا لَمَّا يَقْضِ مَآ أَمَرَهُۥ",
                        "translated_name": "«كلا» حقا «لمَّا يقض» لم يفعل «ما أمره» به ربه."
                    },
                    {
                        "id": 5782,
                        "chapter_id": 80,
                        "verses_translate_name": "الآيات",
                        "verses_number": "24",
                        "arabic_name": "فَلْيَنظُرِ ٱلْإِنسَـٰنُ إِلَىٰ طَعَامِهِۦٓ",
                        "translated_name": "«فلينظر الإنسان» نظر اعتبار «إلى طعامه» كيف قدر ودبر له."
                    },
                    {
                        "id": 5783,
                        "chapter_id": 80,
                        "verses_translate_name": "الآيات",
                        "verses_number": "25",
                        "arabic_name": "أَنَّا صَبَبْنَا ٱلْمَآءَ صَبًّا",
                        "translated_name": "«أنا صببنا الماء» من السحاب «صبا»."
                    },
                    {
                        "id": 5784,
                        "chapter_id": 80,
                        "verses_translate_name": "الآيات",
                        "verses_number": "26",
                        "arabic_name": "ثُمَّ شَقَقْنَا ٱلْأَرْضَ شَقًّا",
                        "translated_name": "«ثم شققنا الأرض» بالنبات «شقا»."
                    },
                    {
                        "id": 5785,
                        "chapter_id": 80,
                        "verses_translate_name": "الآيات",
                        "verses_number": "27",
                        "arabic_name": "فَأَنۢبَتْنَا فِيهَا حَبًّا",
                        "translated_name": "«فأنبتنا فيها حبا» كالحنطة والشعير."
                    },
                    {
                        "id": 5786,
                        "chapter_id": 80,
                        "verses_translate_name": "الآيات",
                        "verses_number": "28",
                        "arabic_name": "وَعِنَبًا وَقَضْبًا",
                        "translated_name": "«وعنبا وقضبا» هو القت الرطب."
                    },
                    {
                        "id": 5787,
                        "chapter_id": 80,
                        "verses_translate_name": "الآيات",
                        "verses_number": "29",
                        "arabic_name": "وَزَيْتُونًا وَنَخْلًا",
                        "translated_name": "«وزيتونا ونخلا»."
                    },
                    {
                        "id": 5788,
                        "chapter_id": 80,
                        "verses_translate_name": "الآيات",
                        "verses_number": "30",
                        "arabic_name": "وَحَدَآئِقَ غُلْبًا",
                        "translated_name": "«وحدائق غلبا» بساتين كثيرة الأشجار."
                    },
                    {
                        "id": 5789,
                        "chapter_id": 80,
                        "verses_translate_name": "الآيات",
                        "verses_number": "31",
                        "arabic_name": "وَفَـٰكِهَةً وَأَبًّا",
                        "translated_name": "«وفاكهة وأبّا» ما ترعاه البهائم وقيل التبن."
                    },
                    {
                        "id": 5790,
                        "chapter_id": 80,
                        "verses_translate_name": "الآيات",
                        "verses_number": "32",
                        "arabic_name": "مَّتَـٰعًا لَّكُمْ وَلِأَنْعَـٰمِكُمْ",
                        "translated_name": "«متاعا» متعة أو تمتيعا كما تقدم في السورة قبلها «لكم ولأنعامكم» تقدم فيها أيضا."
                    },
                    {
                        "id": 5791,
                        "chapter_id": 80,
                        "verses_translate_name": "الآيات",
                        "verses_number": "33",
                        "arabic_name": "فَإِذَا جَآءَتِ ٱلصَّآخَّةُ",
                        "translated_name": "«فإذا جاءت الصاخة» النفخة الثانية."
                    },
                    {
                        "id": 5792,
                        "chapter_id": 80,
                        "verses_translate_name": "الآيات",
                        "verses_number": "34",
                        "arabic_name": "يَوْمَ يَفِرُّ ٱلْمَرْءُ مِنْ أَخِيهِ",
                        "translated_name": "«يوم يفر المرء من أخيه»."
                    },
                    {
                        "id": 5793,
                        "chapter_id": 80,
                        "verses_translate_name": "الآيات",
                        "verses_number": "35",
                        "arabic_name": "وَأُمِّهِۦ وَأَبِيهِ",
                        "translated_name": "«وأمه وأبيه»."
                    },
                    {
                        "id": 5794,
                        "chapter_id": 80,
                        "verses_translate_name": "الآيات",
                        "verses_number": "36",
                        "arabic_name": "وَصَـٰحِبَتِهِۦ وَبَنِيهِ",
                        "translated_name": "«وصاحبته» زوجته «وبنيه» يوم بدل من إذا، وجوابها دل عليه."
                    },
                    {
                        "id": 5795,
                        "chapter_id": 80,
                        "verses_translate_name": "الآيات",
                        "verses_number": "37",
                        "arabic_name": "لِكُلِّ ٱمْرِئٍ مِّنْهُمْ يَوْمَئِذٍ شَأْنٌ يُغْنِيهِ",
                        "translated_name": "«لكل امرىءٍ منهم يومئذ شأن يغنيه» حال يشغله عن شأن غيره، أي اشتغل كل واحد بنفسه."
                    },
                    {
                        "id": 5796,
                        "chapter_id": 80,
                        "verses_translate_name": "الآيات",
                        "verses_number": "38",
                        "arabic_name": "وُجُوهٌ يَوْمَئِذٍ مُّسْفِرَةٌ",
                        "translated_name": "وجوه يومئذ مسفرة» مضيئة."
                    },
                    {
                        "id": 5797,
                        "chapter_id": 80,
                        "verses_translate_name": "الآيات",
                        "verses_number": "39",
                        "arabic_name": "ضَاحِكَةٌ مُّسْتَبْشِرَةٌ",
                        "translated_name": "«ضاحكة مستبشرة» فرحة وهم المؤمنون."
                    },
                    {
                        "id": 5798,
                        "chapter_id": 80,
                        "verses_translate_name": "الآيات",
                        "verses_number": "40",
                        "arabic_name": "وَوُجُوهٌ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٌ",
                        "translated_name": "«ووجوه يومئذ عليها غَبَرة» غبار."
                    },
                    {
                        "id": 5799,
                        "chapter_id": 80,
                        "verses_translate_name": "الآيات",
                        "verses_number": "41",
                        "arabic_name": "تَرْهَقُهَا قَتَرَةٌ",
                        "translated_name": "«ترهقها» تغشاها «قترة» ظلمة وسواد."
                    },
                    {
                        "id": 5800,
                        "chapter_id": 80,
                        "verses_translate_name": "الآيات",
                        "verses_number": "42",
                        "arabic_name": "أُو۟لَـٰٓئِكَ هُمُ ٱلْكَفَرَةُ ٱلْفَجَرَةُ",
                        "translated_name": "«أولئك» أهل هذه الحال «هم الكفرة الفجرة» أي الجامعون بين الكفر والفجور."
                    }
                ],
                "page_arabic_ayah": "عَبَسَ وَتَوَلَّىٰٓ (١)  أَن جَآءَهُ ٱلْأَعْمَىٰ (٢)  وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ (٣)  أَوْ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكْرَىٰٓ (٤)  أَمَّا مَنِ ٱسْتَغْنَىٰ (٥)  فَأَنتَ لَهُۥ تَصَدَّىٰ (٦)  وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ (٧)  وَأَمَّا مَن جَآءَكَ يَسْعَىٰ (٨)  وَهُوَ يَخْشَىٰ (٩)  فَأَنتَ عَنْهُ تَلَهَّىٰ (١٠)  كَلَّآ إِنَّهَا تَذْكِرَةٌ (١١)  فَمَن شَآءَ ذَكَرَهُۥ (١٢)  فِى صُحُفٍ مُّكَرَّمَةٍ (١٣)  مَّرْفُوعَةٍ مُّطَهَّرَةٍۭ (١٤)  بِأَيْدِى سَفَرَةٍ (١٥)  كِرَامٍۭ بَرَرَةٍ (١٦)  قُتِلَ ٱلْإِنسَـٰنُ مَآ أَكْفَرَهُۥ (١٧)  مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ (١٨)  مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ (١٩)  ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ (٢٠)  ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥ (٢١)  ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ (٢٢)  كَلَّا لَمَّا يَقْضِ مَآ أَمَرَهُۥ (٢٣)  فَلْيَنظُرِ ٱلْإِنسَـٰنُ إِلَىٰ طَعَامِهِۦٓ (٢٤)  أَنَّا صَبَبْنَا ٱلْمَآءَ صَبًّا (٢٥)  ثُمَّ شَقَقْنَا ٱلْأَرْضَ شَقًّا (٢٦)  فَأَنۢبَتْنَا فِيهَا حَبًّا (٢٧)  وَعِنَبًا وَقَضْبًا (٢٨)  وَزَيْتُونًا وَنَخْلًا (٢٩)  وَحَدَآئِقَ غُلْبًا (٣٠)  وَفَـٰكِهَةً وَأَبًّا (٣١)  مَّتَـٰعًا لَّكُمْ وَلِأَنْعَـٰمِكُمْ (٣٢)  فَإِذَا جَآءَتِ ٱلصَّآخَّةُ (٣٣)  يَوْمَ يَفِرُّ ٱلْمَرْءُ مِنْ أَخِيهِ (٣٤)  وَأُمِّهِۦ وَأَبِيهِ (٣٥)  وَصَـٰحِبَتِهِۦ وَبَنِيهِ (٣٦)  لِكُلِّ ٱمْرِئٍ مِّنْهُمْ يَوْمَئِذٍ شَأْنٌ يُغْنِيهِ (٣٧)  وُجُوهٌ يَوْمَئِذٍ مُّسْفِرَةٌ (٣٨)  ضَاحِكَةٌ مُّسْتَبْشِرَةٌ (٣٩)  وَوُجُوهٌ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٌ (٤٠)  تَرْهَقُهَا قَتَرَةٌ (٤١)  أُو۟لَـٰٓئِكَ هُمُ ٱلْكَفَرَةُ ٱلْفَجَرَةُ (٤٢)",
                "is_read": false
            }
        ]
    }
