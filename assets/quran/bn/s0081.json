                        "verses_number": "1",
                        "arabic_name": "إِذَا ٱلشَّمْسُ كُوِّرَتْ",
                        "translated_name": "যখন সূর্য অন্ধকারাচ্ছন্ন হয়ে যাবে,"
                    },
                    {
                        "id": 5802,
                        "chapter_id": 81,
                        "verses_translate_name": "আয়াত",
                        "verses_number": "2",
                        "arabic_name": "وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ",
                        "translated_name": "আর যখন তারকারা নিস্তেজ হয়ে পড়বে,"
                    },
                    {
                        "id": 5803,
                        "chapter_id": 81,
                        "verses_translate_name": "আয়াত",
                        "verses_number": "3",
                        "arabic_name": "وَإِذَا ٱلْجِبَالُ سُيِّرَتْ",
                        "translated_name": "আর যখন পাহাড়গুলোকে অপসারণ করা হবে,"
                    },
                    {
                        "id": 5804,
                        "chapter_id": 81,
                        "verses_translate_name": "আয়াত",
                        "verses_number": "4",
                        "arabic_name": "وَإِذَا ٱلْعِشَارُ عُطِّلَتْ",
                        "translated_name": "আর যখন পূর্ণ-গর্ভা উষ্টীদের পরিত্যাগ করা হবে;"
                    },
                    {
                        "id": 5805,
                        "chapter_id": 81,
                        "verses_translate_name": "আয়াত",
                        "verses_number": "5",
                        "arabic_name": "وَإِذَا ٱلْوُحُوشُ حُشِرَتْ",
                        "translated_name": "আর যখন বন্য পশুদের সমবেত করা হবে,"
