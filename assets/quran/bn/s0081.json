                        "chapter_id": 81,
                        "verses_translate_name": "আয়াত",
                        "verses_number": "8",
                        "arabic_name": "وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ",
                        "translated_name": "আর যখন জীবন্ত-প্রোথিত কন্যাসন্তানকে প্রশ্ন করা হবে --"
