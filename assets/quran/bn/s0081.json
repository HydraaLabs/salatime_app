                    {
                        "id": 5806,
                        "chapter_id": 81,
                        "verses_translate_name": "আয়াত",
                        "verses_number": "6",
                        "arabic_name": "وَإِذَا ٱلْبِحَارُ سُجِّرَتْ",
                        "translated_name": "আর যখন সাগর-নদী ফেঁপে উঠবে,"
                    },
                    {
                        "id": 5807,
                        "chapter_id": 81,
                        "verses_translate_name": "আয়াত",
