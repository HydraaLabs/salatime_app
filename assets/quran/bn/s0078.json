                    {
                        "id": 5676,
                        "chapter_id": 78,
                        "verses_translate_name": "আয়াত",
                        "verses_number": "4",
                        "arabic_name": "كَلَّا سَيَعْلَمُونَ",
                        "translated_name": "না, তারা শীঘ্রই জানতে পারবে।"
                    },
