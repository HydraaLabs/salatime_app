                        "chapter_id": 78,
                        "verses_translate_name": "আয়াত",
                        "verses_number": "5",
                        "arabic_name": "ثُمَّ كَلَّا سَيَعْلَمُونَ",
                        "translated_name": "পুনশ্চ, না, তারা অতিশীঘ্রই জানতে পারবে।"
                    },
                    {
                        "id": 5678,
                        "chapter_id": 78,
                        "verses_translate_name": "আয়াত",
                        "verses_number": "6",
                        "arabic_name": "أَلَمْ نَجْعَلِ ٱلْأَرْضَ مِهَـٰدًا",
                        "translated_name": "আমরা কি পৃথিবীটাকে পাতানো-বিছানারূপে বানাই নি,"
                    },
                    {
                        "id": 5679,
                        "chapter_id": 78,
                        "verses_translate_name": "আয়াত",
                        "verses_number": "7",
                        "arabic_name": "وَٱلْجِبَالَ أَوْتَادًا",
                        "translated_name": "আর পাহাড়-পর্বতকে খুটিরূঁপে?"
                    },
                    {
                        "id": 5680,
                        "chapter_id": 78,
                        "verses_translate_name": "আয়াত",
                        "verses_number": "8",
                        "arabic_name": "وَخَلَقْنَـٰكُمْ أَزْوَٰجًا",
                        "translated_name": "আর আমরা তোমাদের সৃষ্টি করেছি জোড়ায়-জোড়ায়;"
                    },
                    {
                        "id": 5681,
                        "chapter_id": 78,
                        "verses_translate_name": "আয়াত",
                        "verses_number": "9",
                        "arabic_name": "وَجَعَلْنَا نَوْمَكُمْ سُبَاتًا",
                        "translated_name": "আর তোমাদের ঘুমকে করেছি বিশ্রাম,"
                    },
                    {
                        "id": 5682,
                        "chapter_id": 78,
                        "verses_translate_name": "আয়াত",
                        "verses_number": "10",
                        "arabic_name": "وَجَعَلْنَا ٱلَّيْلَ لِبَاسًا",
