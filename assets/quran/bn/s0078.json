                    },
                    {
                        "id": 5695,
                        "chapter_id": 78,
                        "verses_translate_name": "আয়াত",
                        "verses_number": "23",
                        "arabic_name": "لَّـٰبِثِينَ فِيهَآ أَحْقَابًا",
